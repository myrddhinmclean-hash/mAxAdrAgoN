# Git stores text files with LF internally and converts on checkout, so a
# Windows working tree and a Linux one no longer disagree about every line.
* text=auto

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary
*.wav binary
*.ogg binary
